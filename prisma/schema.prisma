// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==============================
// Auth Models (NextAuth v5)
// ==============================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // hashed, null if using OAuth only
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  posts           Post[]
  settings        PageSetting?
  rssSources      RssSource[]
  affiliateClicks AffiliateClick[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ==============================
// Bot Models
// ==============================

model Post {
  id          String     @id @default(cuid())
  userId      String
  title       String
  content     String
  link        String?
  fbPostId    String?
  status      PostStatus @default(PENDING)
  scheduledAt DateTime?
  postedAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("posts")
}

enum PostStatus {
  PENDING
  POSTED
  FAILED
  SKIPPED
}

// Facebook Page Settings (1 User = 1 Page)
model PageSetting {
  id                 String   @id @default(cuid())
  userId             String   @unique
  pageId             String   // Facebook Page ID
  pageAccessToken    String   // Facebook Page Access Token (long-lived)
  newsSchedule       String?  // JSON string of times e.g. '["08:00","12:00"]'
  disableAi          Boolean  @default(false)
  postAsPhoto        Boolean  @default(false) // If true, upload photo. If false (default), post link preview.
  addTextOnImage     Boolean  @default(true)  // If true, write headline and tag on the image
  isActive           Boolean  @default(true)
  
  // Affiliate Settings
  affiliateEnabled   Boolean  @default(false)
  affiliateLinks     String?  @db.Text // JSON: [{id, label, url, platform}]
  affiliateMode      String   @default("random") // "random" | "rotate" | "fixed"
  affiliateTag       String?  // Custom CTA text
  lastAffiliateIndex Int      @default(0) // Track rotation index
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("page_settings")
}

// RSS Feed Sources
model RssSource {
  id        String   @id @default(cuid())
  userId    String
  name      String
  url       String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("rss_sources")
}

// Affiliate Click Tracking
model AffiliateClick {
  id          String   @id @default(cuid())
  userId      String   // Which user's affiliate link was clicked
  postId      String?  // Associated FB post ID if applicable
  linkId      String?  // Internal ID of the affiliate link from the JSON array
  platform    String   @default("shopee")
  ipAddress   String?  // For basic unique click tracking (hash it if privacy concerns)
  userAgent   String?
  clickedAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("affiliate_clicks")
}

// Global key-value settings (system-wide, not per-user)
model Setting {
  key   String @id
  value String

  @@map("settings")
}